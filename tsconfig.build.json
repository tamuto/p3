{
  // 配布物の CLI・serve を JavaScript にする（scripts/build-cli.mjs）。入口・tasks・kit の Node で動く部分を .build/ に 1:1 で出し、
  // 相対の import の .ts を .js に書き換える。パッケージ名の import と置き場所は scripts/build-cli.mjs が直す。型検査は tsconfig.json
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "packages",
    "outDir": ".build",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["packages/p3/src/cli", "packages/p3/src/core", "packages/p3/src/server", "packages/tasks/src/cli", "packages/tasks/src/core", "packages/tasks/src/server", "packages/tasks/src/shared", "packages/kit/src"]
}

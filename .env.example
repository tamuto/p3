# --- pcube サーバ ---
# マシンごとの設定。pcube 本体のこの .env を CLI / サーバとも読む（プロジェクトの .pcube/ には置かない）
# データディレクトリ（既定: git のメインの作業ツリー → 上位へ辿って .pcube/ を探す）
# PCUBE_DATA_DIR=/path/to/your-repo/.pcube
# CLI で変更したときの変更者（AI は ai:<名前>）
# PCUBE_ACTOR=ai:claude
# CLI の「今の要望」（既定は要望の作業ツリーのブランチから判定）
# PCUBE_REQUEST=261009-k7m3x
# PCUBE_PORT=4310
# 待ち受けるアドレス（既定 0.0.0.0。自分のマシンだけに絞るなら 127.0.0.1）。Vite にも効く
# PCUBE_HOST=0.0.0.0

# --- Preflight: llmcs/codex-workspace（Docker 内の codex app-server）---
# 認証情報: Docker ボリューム内の auth.json か、ホストのファイルのどちらか
PCUBE_CODEX_AUTH_VOLUME=denv-cc-remote_codex-state
# PCUBE_CODEX_AUTH_FILE=/root/.codex/auth.json
# 開発コンテナ内のパス → Docker デーモン（ホスト）から見たパス
PCUBE_CODEX_PATH_MAP=/workspaces=/root/workspaces
# PCUBE_CODEX_MODEL=
# PCUBE_CODEX_EFFORT=medium
# イメージの自動更新を止める (0)
# PCUBE_CODEX_ENSURE_IMAGE=1
# codex / mock（既定: 認証設定があれば codex）
# PCUBE_PREFLIGHT_ENGINE=codex

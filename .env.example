# infodb p3 の環境変数の例。
#
# P3 は .env を自動では読まない。マシンごとの設定は個人設定（~/.config/infodb-p3/config.yaml）に書くのが基本で、
# 環境変数はそれを一時的に上書きしたいときに使う（シェルの export、direnv、docker run --env-file など）。
# 値は 項目ごとに CLI の明示 → 環境変数 → 個人設定 → 既定値 の順で決まる。空にすると個人設定を使わずに既定値に戻す。
# 個人設定の項目との対応は README の「マシンごとの設定」。

# --- 操作ごとの指定（環境変数か --actor / --req だけで決める）---
# CLI で変更したときの変更者（AI は ai:<名前>）
# PCUBE_ACTOR=ai:claude
# CLI の「今の要望」（既定は要望の作業ツリーのブランチから判定）
# PCUBE_REQUEST=

# --- serve（個人設定 serve.host / serve.port）---
# PCUBE_HOST=127.0.0.1
# PCUBE_PORT=4310

# --- Preflight（個人設定 codex.* / preflight.engine）---
# 認証は ChatGPT プラン（p3 chatgpt login か設定画面の「Continue with ChatGPT」）が基本。トークンはここに書かない
# 旧来: Codex の初期設定でサインインした auth.json（Docker ボリュームか、ホストのファイル）
# PCUBE_CODEX_AUTH_VOLUME=
# PCUBE_CODEX_AUTH_FILE=
# legacy にすると ChatGPT に接続していても旧来の auth.json を使う（既定 auto）
# PCUBE_CODEX_AUTH=legacy
# DevContainer のとき: このマシンのパス=Docker デーモンから見たパス（カンマ区切り）
# PCUBE_CODEX_PATH_MAP=/workspaces=/path/on/docker/host/workspaces
# PCUBE_CODEX_MODEL=
# PCUBE_CODEX_EFFORT=medium
# 0 で Preflight の前のイメージの作り直し（1日ごと）を止める
# PCUBE_CODEX_ENSURE_IMAGE=1
# mock にすると Mock（簡易評価）で Preflight する（明示したときだけ。認証が無いときに自動では切り替えない）
# PCUBE_PREFLIGHT_ENGINE=codex

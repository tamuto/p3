# --- pcube サーバ ---
# マシンごとの設定。pcube 本体のこの .env を CLI / サーバとも読む（プロジェクトのデータのフォルダには置かない）
# 操作するプロジェクトは環境変数では決めない（個人設定 ~/.config/infodb-p3/config.yaml と今いる場所から決まる）
# CLI で変更したときの変更者（AI は ai:<名前>）
# PCUBE_ACTOR=ai:claude
# CLI の「今の要望」（既定は要望の作業ツリーのブランチから判定）
# PCUBE_REQUEST=261009-k7m3x
# PCUBE_PORT=4310
# 待ち受けるアドレス（既定 0.0.0.0。自分のマシンだけに絞るなら 127.0.0.1）。Vite にも効く
# PCUBE_HOST=0.0.0.0

# --- Preflight: llmcs/codex-workspace（Docker 内の codex app-server）---
# 認証は ChatGPT プラン（p3 chatgpt login か設定画面の「Continue with ChatGPT」）が基本。ここには書かない
# 旧来: Codex の初期設定でサインインした auth.json（Docker ボリューム内か、ホストのファイル）。ChatGPT に接続していなければ使う
# PCUBE_CODEX_AUTH_VOLUME=denv-cc-remote_codex-state
# PCUBE_CODEX_AUTH_FILE=/root/.codex/auth.json
# legacy にすると ChatGPT に接続していても旧来の auth.json を使う
# PCUBE_CODEX_AUTH=legacy
# 開発コンテナ内のパス → Docker デーモン（ホスト）から見たパス
PCUBE_CODEX_PATH_MAP=/workspaces=/root/workspaces
# PCUBE_CODEX_MODEL=
# PCUBE_CODEX_EFFORT=medium
# イメージの自動更新を止める (0)
# PCUBE_CODEX_ENSURE_IMAGE=1
# mock にすると Mock（簡易評価）で Preflight する（明示したときだけ。認証が無いときに自動では切り替えない）
# PCUBE_PREFLIGHT_ENGINE=codex

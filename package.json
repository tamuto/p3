{
  "name": "pcube",
  "version": "0.1.0",
  "private": true,
  "description": "File-based project management with AI-powered preflight (Codex App Server)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "demo:reset": "tsx src/server/scripts/seedDemo.ts --force"
  },
  "dependencies": {
    "@hono/node-server": "~2.1.3",
    "@llmcs/codex-workspace": "link:../llmcs/codex-workspace-ts",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "packageManager": "pnpm@12.10.1"
}

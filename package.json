{
  "name": "pcube",
  "version": "0.1.0",
  "private": true,
  "description": "File-based project management with AI-powered preflight (Codex App Server)",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "bin": {
    "pcube": "bin/pcube.mjs"
  },
  "scripts": {
    "dev": "pnpm demo && concurrently -n server,web -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/cli/main.ts serve --dir .pcube-demo",
    "dev:web": "vite",
    "build": "vite build",
    "start": "pnpm demo && node bin/pcube.mjs serve --dir .pcube-demo",
    "pcube": "node bin/pcube.mjs",
    "demo": "tsx scripts/demo.ts",
    "demo:reset": "tsx scripts/demo.ts --force",
    "routes": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "~2.1.3",
    "@llmcs/codex-workspace": "link:../llmcs/codex-workspace-ts",
    "@tanstack/react-router": "^1.170.41",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}

{
  "name": "p3-workspace",
  "version": "0.18.0",
  "private": true,
  "description": "infodb p3 の開発用のリポジトリ（pnpm workspace）。配布するのは packages/p3（@infodb/p3）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm demo && concurrently -n server,web -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false packages/p3/src/cli/main.ts serve --dir .p3-demo",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-cli.mjs --require-web",
    "start": "pnpm demo && node packages/p3/bin/p3.mjs serve --dir .p3-demo",
    "p3": "node packages/p3/bin/p3.mjs",
    "demo": "tsx scripts/demo.ts",
    "demo:reset": "tsx scripts/demo.ts --force",
    "routes": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit -p .",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error packages/shared/src packages/tasks/src packages/observer/src packages/app/src packages/p3/src packages/p3/bin scripts test vite.config.ts vitest.config.ts vitest.ui.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run -c vitest.ui.config.ts",
    "check": "pnpm check:browser && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:ui",
    "check:browser": "tsx scripts/check-browser.ts",
    "verify:pack": "node scripts/verify-pack.mjs",
    "video": "node scripts/video/record.mjs",
    "package": "pnpm build && npm pack ./dist/package"
  },
  "devDependencies": {
    "@infodb/chatgpt-plan": "^0.1.1",
    "@infodb/codex-workspace": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "hono": "^4.13.13",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright-core": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
